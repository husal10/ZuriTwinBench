<?xml version="1.0" encoding="UTF-8"?>
<!--
    intersection.sumocfg — Zurich Intersection Digital Twin
    Genser et al. (2023), Data in Brief 48, 109117

    Usage (from simulation/ directory):
      sumo-gui -c intersection.sumocfg
      # OR (recommended — handles night-mode TL switching via TraCI):
      python run_sumo.py

    Files required in simulation/:
      intersection.net.xml   — built by: python ../build_network.py
      flows.rou.xml          — generated by: python ../demand/demand_generator.py
      trams.rou.xml          — generated by demand_generator.py
      pedestrians.rou.xml    — generated by demand_generator.py
      detectors.add.xml      — generated by demand_generator.py

    Night-mode TL switching:
      t=3654s (01:00:54): TL program switches day → night (SVG §68 flashing amber)
      t=18000s (05:00:00): TL program switches night → day
      This is handled by run_sumo.py via TraCI. For sumo-gui without TraCI,
      the day program runs continuously (minor accuracy loss 01:00–05:00).

    Output files (written to output/):
      summary.xml         — per-step vehicle counts and queue lengths
      tripinfo.xml        — per-vehicle travel time and delay statistics
      queues.xml          — queue length per edge (60s aggregation)
      statistics.xml      — global simulation statistics
      det_d*.xml          — E1 detector occupancy/count (D1-D10, 15min periods)
-->
<configuration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/sumoConfiguration.xsd">

    <input>
        <net-file value="intersection.net.xml"/>
        <!--
            Three route files; SUMO merges by begin/depart time automatically:
              flows.rou.xml       — vTypes + route defs + 15-min demand flows
              trams_v2.rou.xml       — tram vehicles sorted by exact CSV depart times
              pedestrians.rou.xml — pedestrian persons from sg7-sg10 activations
        -->
        <route-files value="flows.rou.xml,trams.rou.xml,pedestrians.rou.xml"/>
        <additional-files value="detectors.add.xml"/>
    </input>

    <time>
        <begin value="0"/>
        <end value="86400"/>
        <step-length value="1.0"/>
    </time>

    <output>
        <summary-output value="output/summary.xml"/>
        <tripinfo-output value="output/tripinfo.xml"/>
        <queue-output value="output/queues.xml" period="60"/>
        <statistic-output value="output/statistics.xml"/>
    </output>

    <processing>
        <!-- Tolerate minor routing issues from demand generation edge cases -->
        <ignore-route-errors value="true"/>
        <!-- Disable teleporting: vehicles queue realistically at signals -->
        <time-to-teleport value="-1"/>
        <time-to-teleport.highways value="-1"/>
        <!-- Collision logging only (not removal): monitor interaction density -->
        <collision.action value="warn"/>
        <!-- Lane change duration 2s per Swiss driving behaviour (VRV Art.44) -->
        <lanechange.duration value="2"/>
    </processing>

    <report>
        <verbose value="true"/>
        <duration-log.statistics value="true"/>
        <no-step-log value="false"/>
    </report>

</configuration>
